// Generated from version.rc.in by CMake - do not edit.
// Puts the version into the Windows executable's file properties.

1 VERSIONINFO
FILEVERSION    @PLV_VERSION_MAJOR@,@PLV_VERSION_MINOR@,@PLV_VERSION_PATCH@,0
PRODUCTVERSION @PLV_VERSION_MAJOR@,@PLV_VERSION_MINOR@,@PLV_VERSION_PATCH@,0
FILEOS         0x4L
FILETYPE       0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "NaturalPoint Inc. DBA OptiTrack"
            VALUE "FileDescription",  "Production Lens Validation"
            VALUE "FileVersion",      "@PLV_VERSION_FULL@"
            VALUE "InternalName",     "CameraViewerApp"
            VALUE "OriginalFilename", "CameraViewerApp.exe"
            VALUE "ProductName",      "Production Lens Validation"
            VALUE "ProductVersion",   "@PLV_VERSION_FULL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
